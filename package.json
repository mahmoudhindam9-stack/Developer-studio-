{
  "name": "developer-studio-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop development studio with a pluggable AI coding agent.",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "web": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.0",
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.developerstudio.desktop",
    "productName": "Developer Studio",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] }
  }
}
